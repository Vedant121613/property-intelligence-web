# ========================================================
# Pureframe Environment Configuration (Coolify & Production)
# ========================================================
NODE_ENV=production
PORT=5000

# --------------------------------------------------------
# Single User Credentials
# --------------------------------------------------------
SINGLE_USER_NAME=user@123
SINGLE_USER_PASS=pass@123

# --------------------------------------------------------
# PostgreSQL Database Configuration
# --------------------------------------------------------
# Option 1: Full connection string (Standard in Coolify)
DATABASE_URL=postgresql://postgres:password@localhost:5432/pureframe_db

# Option 2: Individual variables
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGDATABASE=pureframe_db
PGPASSWORD=password
PGSSL=false

# --------------------------------------------------------
# CORS (Optional when deployed as unified container)
# --------------------------------------------------------
FRONTEND_URL=https://your-domain.com

# --------------------------------------------------------
# Optional MSG91 SMS Gateway (Backend Secrets Only)
# --------------------------------------------------------
MSG91_AUTH_KEY=
MSG91_WIDGET_ID=366a666d3673323037323934
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
